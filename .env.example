# MedGuard needs NO environment variables or secrets to run.
# This file exists to show the convention. Never commit a real .env file.
# If you later add a backend, copy this to .env and fill in REAL values locally only.

# APP_ENV=demo
# SESSION_SECRET=replace-with-a-long-random-string
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medguard
# API_KEY=your-api-key-here
